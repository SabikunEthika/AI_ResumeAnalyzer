# Keep this file safe to commit. Put real values only in your ignored .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_SECOND_FALLBACK_MODEL=gemini-3.8-flash
